# ============================================================
# Environment Variables — FitTrack SaaS
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore by default.
#
# Prefix rules:
#   NEXT_PUBLIC_*  → exposed to the browser (safe for non-secrets)
#   (no prefix)    → server-only (never sent to the browser)
# ============================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found at: Supabase dashboard → Project Settings → API

# Your project URL (safe to expose — it is a public API endpoint)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose — protected by RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key — NEVER prefix with NEXT_PUBLIC_
# Only used for admin scripts / migrations, not the web app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Rate Limiting — Upstash Redis ───────────────────────────────────────────
# Recommended for production. Without these the app uses an in-process Map
# that is not shared across serverless replicas (rate limits reset per cold start).
#
# Get a free database at https://console.upstash.com → Create Database → Redis
# Then copy the "REST URL" and "REST Token" from the database details page.
#
# Leave blank (or unset) for local development — the in-process fallback kicks in.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Sentry — Error Tracking & Observability ─────────────────────────────────
# Required in production. Leave blank in local dev to suppress Sentry.
# Get from: sentry.io → Your Project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Required in CI for uploading source maps (keeps stack traces readable in prod).
# Generate at: sentry.io → Settings → Auth Tokens → Create New Token
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# ─── E2E Tests — Playwright ───────────────────────────────────────────────────
# Only needed when running `npm run test:e2e`.
# Use a SEPARATE Supabase project — never point at production data.
E2E_SUPABASE_URL=https://your-test-project.supabase.co
E2E_SUPABASE_ANON_KEY=your-test-anon-key
E2E_USER_EMAIL=test@yourproject.com
E2E_USER_PASSWORD=TestPassword123!
